DIRS += ["content", "locales"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

include("../branding-common.mozbuild")
FirefoxBranding()

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    FINAL_TARGET_FILES.chrome.icons.default += [
        "kogitsune.png",
        "kogitsune128.png",
        "kogitsune16.png",
        "kogitsune256.png",
        "kogitsune32.png",
        "kogitsune48.png",
        "kogitsune64.png",
    ]
